  @@unique([sesionId, orden])
  @@map("ejercicios_sesion")
}

model SerieEntrenamiento {
  id                Int      @id @default(autoincrement())
  ejercicioSesionId Int      @map("ejercicio_sesion_id")
  numero            Int
  peso              Decimal? @db.Decimal(8, 2)
  repeticiones      Int?
  esfuerzoPercibido Int?     @map("esfuerzo_percibido")
