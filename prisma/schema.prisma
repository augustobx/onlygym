}

model ReservaClase {
  id             Int       @id @default(autoincrement())
  tenantId       Int       @map("tenant_id")
  claseId        Int       @map("clase_id")
  clienteId      Int       @map("cliente_id")
  estado         String    @default("confirmada")
  posicionEspera Int?      @map("posicion_espera")
  creadaEn       DateTime  @default(now()) @map("creada_en")
  canceladaEn    DateTime? @map("cancelada_en")
  asistenciaEn   DateTime? @map("asistencia_en")

  tenant  Tenant  @relation(fields: [tenantId], references: [id])
  clase   Clase   @relation(fields: [claseId], references: [id])
  cliente Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  @@unique([claseId, clienteId])
  @@index([tenantId, clienteId, estado])
  @@map("reservas_clase")
}

model MovimientoPuntos {
