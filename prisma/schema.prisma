// --- PLANO DE CONTROL SAAS & SUPERADMIN (DEPLOY V4) ---

model SuperAdmin {
  id        Int      @id @default(autoincrement())
  email     String   @unique @db.VarChar(120)
  password  String   @db.VarChar(255)
  nombre    String   @db.VarChar(100)
  rol       String   @default("superadmin")
  creadoEn  DateTime @default(now()) @map("creado_en")

  @@map("superadmins")
}

model PlanSaaS {
  id               Int      @id @default(autoincrement())
  codigo           String   @unique @db.VarChar(50) // "STARTER", "PRO", "ENTERPRISE"
  nombre           String   @db.VarChar(100)
  descripcion      String?  @db.Text
  precioMensual    Decimal  @map("precio_mensual") @db.Decimal(10, 2)
  limiteUsuarios   Int      @default(5) @map("limite_usuarios")
  limiteSucursales Int      @default(1) @map("limite_sucursales")
  limiteSocios     Int?     @default(500) @map("limite_socios")
  modulos          Json?
  activo           Boolean  @default(true)
  creadoEn         DateTime @default(now()) @map("creado_en")
  actualizadoEn    DateTime @updatedAt @map("actualizado_en")

  suscripciones SuscripcionSaaS[]
  tenants       Tenant[]

  @@map("planes_saas")
}

model SuscripcionSaaS {
  id               Int       @id @default(autoincrement())
  tenantId         Int       @map("tenant_id")
  planId           Int       @map("plan_id")
  estado           String    @default("activa") // "activa", "prueba", "suspendida", "cancelada"
  fechaInicio      DateTime  @default(now()) @map("fecha_inicio")
  fechaVencimiento DateTime  @map("fecha_vencimiento")
  monto            Decimal   @db.Decimal(10, 2)
  intervalo        String    @default("mensual")
  metodoPago       String?   @map("metodo_pago")
  notas            String?   @db.Text
  creadaEn         DateTime  @default(now()) @map("creada_en")

  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan            PlanSaaS         @relation(fields: [planId], references: [id])
  pagosPlataforma PagoPlataforma[]

  @@index([tenantId, estado])
  @@map("suscripciones_saas")
}

model PagoPlataforma {
  id            Int      @id @default(autoincrement())
  suscripcionId Int      @map("suscripcion_id")
  tenantId      Int      @map("tenant_id")
  monto         Decimal  @db.Decimal(10, 2)
  metodoPago    String   @map("metodo_pago")
  referencia    String?  @db.VarChar(100)
  fechaPago     DateTime @default(now()) @map("fecha_pago")
  comprobante   String?  @db.Text
  estado        String   @default("completado")

  suscripcion SuscripcionSaaS @relation(fields: [suscripcionId], references: [id], onDelete: Cascade)

  @@index([tenantId, fechaPago])
  @@map("pagos_plataforma")
}

// --- FASE 8: SEGUIMIENTO COMERCIAL Y RETENCIÓN CRM ---

model SeguimientoCliente {
  id              Int       @id @default(autoincrement())
  tenantId        Int       @map("tenant_id")
  clienteId       Int       @map("cliente_id")
  usuarioId       String?   @map("usuario_id")
  tipo            String    @db.VarChar(50) // "whatsapp", "llamada", "email", "nota", "oferta"
  estado          String    @default("pendiente") // "pendiente", "contactado", "recuperado", "descartado"
  motivo          String?   @db.VarChar(120) // "inactividad_7d", "inactividad_14d", "vencimiento_proximo", "caida_frecuencia", "manual"
  resultado       String?   @db.Text
  proximoContacto DateTime? @map("proximo_contacto")
  creadoEn        DateTime  @default(now()) @map("creado_en")

  tenant  Tenant  @relation(fields: [tenantId], references: [id])
  cliente Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  usuario User?   @relation(fields: [usuarioId], references: [id])

  @@index([tenantId, clienteId, creadoEn])
  @@index([tenantId, estado])
  @@map("seguimientos_clientes")
}

// --- FASE 9: FIDELIZACIÓN, REGLAS DE PUNTOS Y DESAFÍOS ---

model ReglaPuntos {
  id          Int      @id @default(autoincrement())
  tenantId    Int      @map("tenant_id")
  evento      String   @db.VarChar(60) // "asistencia", "entrenamiento_completo", "racha_3d", "racha_7d", "renovacion_membresia", "cumpleanos"
  puntos      Int
  activo      Boolean  @default(true)
  descripcion String?  @db.VarChar(200)

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, evento])
  @@map("reglas_puntos")
}

model Desafio {
  id               Int       @id @default(autoincrement())
  tenantId         Int       @map("tenant_id")
  titulo           String    @db.VarChar(140)
  descripcion      String    @db.Text
  tipo             String    @db.VarChar(50) // "asistencias_semana", "entrenamientos_mes", "visitas_mes", "peso_total"
  meta             Int       // Cantidad objetivo
  puntosRecompensa Int       @map("puntos_recompensa")
  fechaInicio      DateTime? @map("fecha_inicio") @db.Date
  fechaFin         DateTime? @map("fecha_fin") @db.Date
  activo           Boolean   @default(true)
  creadoEn         DateTime  @default(now()) @map("creado_en")

  tenant         Tenant                 @relation(fields: [tenantId], references: [id])
  participaciones ParticipacionDesafio[]

  @@index([tenantId, activo])
  @@map("desafios")
}

model ParticipacionDesafio {
  id              Int       @id @default(autoincrement())
  tenantId        Int       @map("tenant_id")
  desafioId       Int       @map("desafio_id")
  clienteId       Int       @map("cliente_id")
  progreso        Int       @default(0)
  completado      Boolean   @default(false)
  completadoEn    DateTime? @map("completado_en")
  puntosOtorgados Boolean   @default(false) @map("puntos_otorgados")
  actualizadoEn   DateTime  @updatedAt @map("actualizado_en")

  tenant  Tenant  @relation(fields: [tenantId], references: [id])
  desafio Desafio @relation(fields: [desafioId], references: [id], onDelete: Cascade)
  cliente Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  @@unique([desafioId, clienteId])
  @@index([tenantId, clienteId])
  @@map("participaciones_desafios")
}

