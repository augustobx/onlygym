  objectKey String   @map("object_key") @db.Text
  mimeType  String   @map("mime_type") @db.VarChar(80)
  creadoEn  DateTime @default(now()) @map("creado_en")

  tenant  Tenant  @relation(fields: [tenantId], references: [id])
  cliente Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  @@index([tenantId, clienteId, fecha])
  @@map("fotos_progreso")
}

model TipoClase {
  id          Int     @id @default(autoincrement())
  tenantId    Int     @map("tenant_id")
  nombre      String  @db.VarChar(100)
  descripcion String? @db.Text
  color       String? @db.VarChar(20)
  activo      Boolean @default(true)

  tenant Tenant  @relation(fields: [tenantId], references: [id])
  clases Clase[]

  @@unique([tenantId, nombre])
  @@map("tipos_clase")
}

model Clase {
  id              Int      @id @default(autoincrement())
  tenantId        Int      @map("tenant_id")
  tipoClaseId     Int      @map("tipo_clase_id")
  entrenadorId    Int?     @map("entrenador_id")
  sucursalId      Int      @map("sucursal_id")
  sala            String?  @db.VarChar(80)
  inicio          DateTime
  duracionMinutos Int      @map("duracion_minutos")
  cupoMaximo      Int      @map("cupo_maximo")
  estado          String   @default("programada")

  tenant     Tenant            @relation(fields: [tenantId], references: [id])
  tipoClase  TipoClase         @relation(fields: [tipoClaseId], references: [id])
  entrenador PerfilEntrenador? @relation(fields: [entrenadorId], references: [id])
  sucursal   Sucursal          @relation(fields: [sucursalId], references: [id])
