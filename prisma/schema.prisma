  @@map("sesiones_entrenamiento")
}

model EjercicioSesion {
  id                   Int      @id @default(autoincrement())
  sesionId             Int      @map("sesion_id")
  ejercicioId          Int      @map("ejercicio_id")
  orden                Int
  seriesObjetivo       Int?     @map("series_objetivo")
  repeticionesObjetivo String?  @map("repeticiones_objetivo") @db.VarChar(30)
  pesoSugerido         Decimal? @map("peso_sugerido") @db.Decimal(8, 2)
  descansoSegundos     Int?     @map("descanso_segundos")
  tiempoSegundos       Int?     @map("tiempo_segundos")
  observaciones        String?  @db.Text

