generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum RolTenant {
  OWNER
  ADMIN
  RECEPCION
  ENTRENADOR
}

model Tenant {
  id               Int       @id @default(autoincrement())
  nombre           String    @db.VarChar(120)
  slug             String    @unique @db.VarChar(80)
  estado           String    @default("activo") // activo, suspendido, prueba, cancelado
  plan             String    @default("profesional")
  planSaaSId       Int?      @map("plan_saas_id")
  modulos          Json?
  fechaAlta        DateTime  @default(now()) @map("fecha_alta")
  fechaVencimiento DateTime? @map("fecha_vencimiento")
  creadoEn         DateTime  @default(now()) @map("creado_en")
  actualizadoEn    DateTime  @updatedAt @map("actualizado_en")

  planSaaS                  PlanSaaS?                 @relation(fields: [planSaaSId], references: [id])
  suscripciones             SuscripcionSaaS[]
  sucursales                Sucursal[]
  usuarios                  TenantUsuario[]
  clientes                  Cliente[]
  membresias                Membresia[]
  pagos                     Pago[]
  productos                 Producto[]
  ventas                    Venta[]
  ingresos                  Ingreso[]
  ejercicios                Ejercicio[]
  rutinas                   Rutina[]
  planesEntrenamiento       PlanEntrenamiento[]
  asignacionesEntrenamiento AsignacionEntrenamiento[]
  sesionesEntrenamiento     SesionEntrenamiento[]
  mediciones                MedicionCorporal[]
  fotosProgreso             FotoProgreso[]
  perfilesEntrenador        PerfilEntrenador[]
  tiposClase                TipoClase[]
  clases                    Clase[]
  reservas                  ReservaClase[]
  movimientosPuntos         MovimientoPuntos[]
  premios                   Premio[]
  canjes                    CanjePremio[]
  beneficios                Beneficio[]
  reglasPuntos              ReglaPuntos[]
  desafios                  Desafio[]
  participacionesDesafios   ParticipacionDesafio[]
  seguimientosCliente       SeguimientoCliente[]
  pushSubscriptions         WebPushSubscription[]
  registroNotificaciones    RegistroNotificacion[]
  notificaciones            Notificacion[]
  sesionesSocio             SesionSocio[]
  usuarioClientes           UsuarioCliente[]
  auditorias                Auditoria[]

  @@map("tenants")
}

model TenantUsuario {
  id       Int       @id @default(autoincrement())
  tenantId Int       @map("tenant_id")
  userId   String    @map("user_id")
  rol      RolTenant
  estado   String    @default("activo")
  creadoEn DateTime  @default(now()) @map("creado_en")

  tenant Tenant @relation(fields: [tenantId], references: [id])
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId])
  @@index([userId, estado])
  @@map("tenant_usuarios")
}

model Sucursal {
  id        Int     @id @default(autoincrement())
  tenantId  Int     @map("tenant_id")
  nombre    String  @db.VarChar(100)
  direccion String? @db.VarChar(255)
  telefono  String? @db.VarChar(30)
  capacidad Int?
  estado    String  @default("activo")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  clientes           Cliente[]
  ingresos           Ingreso[]
  pagos              Pago[]
  ventas             Venta[]
  usuarios           User[]
  membresias         Membresia[]
  productos          Producto[]
  horarios           ConfiguracionHorario[]
  clases             Clase[]
  perfilesEntrenador PerfilEntrenador[]
  clientesHabituales Cliente[]              @relation("SucursalHabitual")

  @@unique([tenantId, nombre])
  @@index([tenantId, estado])
  @@map("sucursales")
}

// --- BETTER AUTH CORE TABLES ---

model User {
  id              String   @id @default(cuid())
  name            String
  email           String   @unique
  username        String?  @unique
  displayUsername String?
  emailVerified   Boolean  @default(false)
  image           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  sessions Session[]
  accounts Account[]

  // GymLink Custom Fields
  nivel  String @default("cajero") // admin, supervisor, cajero
  estado String @default("activo")

  // Relations
  sucursales        Sucursal[]
  ventas            Venta[]
  movimientosCuenta CuentaMovimiento[]
  tenantMemberships TenantUsuario[]
  perfilEntrenador  PerfilEntrenador?
  seguimientos      SeguimientoCliente[]
  pushSubscriptions WebPushSubscription[]

  @@map("user")
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  issuer                String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@map("account")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("verification")
}

// --- GYMLINK TABLES ---

model Cliente {
  id                 Int       @id @default(autoincrement())
  tenantId           Int       @map("tenant_id")
  documento          String    @db.VarChar(20)
  nombre             String    @db.VarChar(100)
  apellido           String    @db.VarChar(100)
  telefono           String?   @db.VarChar(20)
  email              String?   @db.VarChar(100)
  direccion          String?   @db.VarChar(255)
  foto               String?   @db.Text
  fechaNacimiento    DateTime? @map("fecha_nacimiento") @db.Date
  contactoEmergencia String?   @map("contacto_emergencia") @db.VarChar(180)
  sucursalHabitualId Int?      @map("sucursal_habitual_id")
  entrenadorId       Int?      @map("entrenador_id")
  fechaRegistro      DateTime  @default(now()) @map("fecha_registro")
  estado             String    @default("activo")

  tenant                    Tenant                    @relation(fields: [tenantId], references: [id])
  sucursalHabitual          Sucursal?                 @relation("SucursalHabitual", fields: [sucursalHabitualId], references: [id])
  entrenador                PerfilEntrenador?         @relation(fields: [entrenadorId], references: [id])
  sucursales                Sucursal[]
  pagos                     Pago[]
  ingresos                  Ingreso[]
  ventas                    Venta[]
  usuarioCliente            UsuarioCliente?
  cuentaCorriente           CuentaCorriente?
  objetivos                 ObjetivoSocio[]
  asignacionesEntrenamiento AsignacionEntrenamiento[]
  sesionesEntrenamiento     SesionEntrenamiento[]
  mediciones                MedicionCorporal[]
  fotosProgreso             FotoProgreso[]
  reservas                  ReservaClase[]
  movimientosPuntos         MovimientoPuntos[]
  canjes                    CanjePremio[]
  participacionesDesafios   ParticipacionDesafio[]
  seguimientos              SeguimientoCliente[]
  pushSubscriptions         WebPushSubscription[]
  registroNotificaciones    RegistroNotificacion[]
  notificaciones            Notificacion[]
  sesionesSocio             SesionSocio[]

  @@unique([tenantId, documento])
  @@index([tenantId, nombre, apellido])
  @@index([tenantId, estado])
  @@map("clientes")
}

model Membresia {
  id           Int     @id @default(autoincrement())
  tenantId     Int     @map("tenant_id")
  nombre       String  @db.VarChar(50)
  diasDuracion Int     @map("dias_duracion")
  precio       Decimal @db.Decimal(10, 2)
  descripcion  String? @db.Text
  estado       String  @default("activo")

  tenant     Tenant     @relation(fields: [tenantId], references: [id])
  pagos      Pago[]
  sucursales Sucursal[]

  @@index([tenantId, estado])
  @@map("membresias")
}

model Pago {
  id               Int      @id @default(autoincrement())
  tenantId         Int      @map("tenant_id")
  clienteId        Int      @map("cliente_id")
  membresiaId      Int      @map("membresia_id")
  sucursalId       Int?     @map("sucursal_id")
  fechaPago        DateTime @default(now()) @map("fecha_pago")
  fechaVencimiento DateTime @map("fecha_vencimiento") @db.Date
  monto            Decimal  @db.Decimal(10, 2)
  metodoPago       String?  @default("efectivo") @map("metodo_pago")
  estado           String   @default("pagado")
  notas            String?  @db.Text

  tenant    Tenant    @relation(fields: [tenantId], references: [id])
  cliente   Cliente   @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  membresia Membresia @relation(fields: [membresiaId], references: [id])
  sucursal  Sucursal? @relation(fields: [sucursalId], references: [id])

  @@index([clienteId])
  @@index([fechaVencimiento])
  @@index([sucursalId])
  @@index([tenantId, fechaPago])
  @@map("pagos")
}

model Producto {
  id            Int      @id @default(autoincrement())
  tenantId      Int      @map("tenant_id")
  codigo        String?  @db.VarChar(50)
  nombre        String   @db.VarChar(150)
  descripcion   String?  @db.Text
  precio        Decimal  @db.Decimal(10, 2)
  stock         Int      @default(0)
  stockMinimo   Int      @default(5) @map("stock_minimo")
  categoria     String?  @db.VarChar(50)
  imagen        String?  @db.VarChar(255)
  estado        String   @default("activo")
  fechaCreacion DateTime @default(now()) @map("fecha_creacion")

  tenant     Tenant      @relation(fields: [tenantId], references: [id])
  ventaItems VentaItem[]
  sucursales Sucursal[]

  @@unique([tenantId, codigo])
  @@index([tenantId, nombre])
  @@map("productos")
}

model Venta {
  id         Int      @id @default(autoincrement())
  tenantId   Int      @map("tenant_id")
  sucursalId Int?     @map("sucursal_id")
  clienteId  Int?     @map("cliente_id")
  tipoPago   String   @default("efectivo") @map("tipo_pago") // 'efectivo', 'cuenta_corriente', 'tarjeta', 'transferencia'
  estadoPago String   @default("pagado") @map("estado_pago") // 'pagado', 'pendiente'
  metodoPago String?  @map("metodo_pago")
  fechaVenta DateTime @default(now()) @map("fecha_venta")
  total      Decimal  @db.Decimal(10, 2)
  userId     String?  @map("user_id")
  notas      String?  @db.Text

  tenant   Tenant      @relation(fields: [tenantId], references: [id])
  sucursal Sucursal?   @relation(fields: [sucursalId], references: [id])
  cliente  Cliente?    @relation(fields: [clienteId], references: [id])
  user     User?       @relation(fields: [userId], references: [id])
  items    VentaItem[]

  @@index([fechaVenta])
  @@index([sucursalId])
  @@index([clienteId])
  @@index([tenantId, fechaVenta])
  @@map("ventas")
}

model VentaItem {
  id             Int     @id @default(autoincrement())
  ventaId        Int     @map("venta_id")
  productoId     Int     @map("producto_id")
  cantidad       Int
  precioUnitario Decimal @map("precio_unitario") @db.Decimal(10, 2)
  subtotal       Decimal @db.Decimal(10, 2)

  venta    Venta    @relation(fields: [ventaId], references: [id], onDelete: Cascade)
  producto Producto @relation(fields: [productoId], references: [id])

  @@index([ventaId])
  @@map("venta_items")
}

model Ingreso {
  id              Int       @id @default(autoincrement())
  tenantId        Int       @map("tenant_id")
  clienteId       Int       @map("cliente_id")
  sucursalId      Int?      @map("sucursal_id")
  documento       String    @db.VarChar(20)
  fechaHora       DateTime  @default(now()) @map("fecha_hora")
  horaSalida      DateTime? @map("hora_salida")
  duracionMinutos Int?      @map("duracion_minutos")
  diasVencido     Int?      @map("dias_vencido")
  estado          String
  motivo          String?   @db.VarChar(255)

  tenant   Tenant    @relation(fields: [tenantId], references: [id])
  cliente  Cliente   @relation(fields: [clienteId], references: [id])
  sucursal Sucursal? @relation(fields: [sucursalId], references: [id])

  @@index([fechaHora])
  @@index([horaSalida])
  @@index([clienteId])
  @@index([sucursalId])
  @@index([tenantId, fechaHora])
  @@map("ingresos")
}

model UsuarioCliente {
  id                  Int       @id @default(autoincrement())
  tenantId            Int       @map("tenant_id")
  clienteId           Int       @unique @map("cliente_id")
  usuario             String    @db.VarChar(20)
  password            String    @db.VarChar(255)
  debeCambiarPassword Boolean   @default(true) @map("debe_cambiar_password")
  ultimoAcceso        DateTime? @map("ultimo_acceso")

  tenant  Tenant  @relation(fields: [tenantId], references: [id])
  cliente Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  @@unique([tenantId, usuario])
  @@index([tenantId])
  @@map("usuarios_clientes")
}

model CuentaCorriente {
  id            Int     @id @default(autoincrement())
  clienteId     Int     @unique @map("cliente_id")
  saldo         Decimal @default(0) @db.Decimal(10, 2)
  limiteCredito Decimal @default(0) @map("limite_credito") @db.Decimal(10, 2)

  cliente     Cliente            @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  movimientos CuentaMovimiento[]

  @@map("cuenta_corriente")
}

model CuentaMovimiento {
  id             Int      @id @default(autoincrement())
  cuentaId       Int      @map("cuenta_id")
  tipo           String // 'cargo', 'pago'
  monto          Decimal  @db.Decimal(10, 2)
  concepto       String?  @db.VarChar(255)
  fecha          DateTime @default(now())
  usuarioAdminId String?  @map("usuario_admin_id")

  cuenta       CuentaCorriente @relation(fields: [cuentaId], references: [id], onDelete: Cascade)
  usuarioAdmin User?           @relation(fields: [usuarioAdminId], references: [id])

  @@index([cuentaId])
  @@index([fecha])
  @@map("cuenta_movimientos")
}

model ConfiguracionHorario {
  id              Int     @id @default(autoincrement())
  sucursalId      Int?    @map("sucursal_id")
  diaSemana       Int     @map("dia_semana") // 0=Domingo, 1=Lunes, 2=Martes, 3=Miércoles, 4=Jueves, 5=Viernes, 6=Sábado
  tipoApertura    String  @default("completo") @map("tipo_apertura") // 'cerrado', 'completo', 'mañana', 'tarde', 'doble'
  horaApertura1   String? @map("hora_apertura_1") @db.VarChar(10) // "06:00"
  horaCierre1     String? @map("hora_cierre_1") @db.VarChar(10) // "22:00"
  horaApertura2   String? @map("hora_apertura_2") @db.VarChar(10)
  horaCierre2     String? @map("hora_cierre_2") @db.VarChar(10)
  capacidadMaxima Int?    @default(50) @map("capacidad_maxima")
  activo          Boolean @default(true)

  sucursal Sucursal? @relation(fields: [sucursalId], references: [id])

  @@unique([sucursalId, diaSemana])
  @@index([sucursalId])
  @@map("configuracion_horarios")
}

model SesionSocio {
  id          String   @id @default(cuid())
  tenantId    Int      @map("tenant_id")
  clienteId   Int      @map("cliente_id")
  tokenHash   String   @unique @map("token_hash") @db.VarChar(64)
  expiraEn    DateTime @map("expira_en")
  creadoEn    DateTime @default(now()) @map("creado_en")
  ultimoUsoEn DateTime @default(now()) @map("ultimo_uso_en")
  userAgent   String?  @map("user_agent") @db.VarChar(255)

  tenant  Tenant  @relation(fields: [tenantId], references: [id])
  cliente Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  @@index([tenantId, clienteId, expiraEn])
  @@map("sesiones_socios")
}

model PerfilEntrenador {
  id             Int      @id @default(autoincrement())
  tenantId       Int      @map("tenant_id")
  userId         String   @unique @map("user_id")
  bio            String?  @db.Text
  especialidades String[]
  foto           String?  @db.Text
  horarios       Json?
  estado         String   @default("activo")
  creadoEn       DateTime @default(now()) @map("creado_en")

  tenant     Tenant             @relation(fields: [tenantId], references: [id])
  user       User               @relation(fields: [userId], references: [id])
  sucursales Sucursal[]
  socios     Cliente[]
  objetivos  ObjetivoSocio[]
  rutinas    Rutina[]
  mediciones MedicionCorporal[]
  clases     Clase[]

  @@index([tenantId, estado])
  @@map("perfiles_entrenador")
}

model ObjetivoSocio {
  id            Int       @id @default(autoincrement())
  tenantId      Int       @map("tenant_id")
  clienteId     Int       @map("cliente_id")
  entrenadorId  Int?      @map("entrenador_id")
  tipo          String    @db.VarChar(80)
  principal     Boolean   @default(false)
  fechaInicio   DateTime  @default(now()) @map("fecha_inicio") @db.Date
  observaciones String?   @db.Text
  activo        Boolean   @default(true)
  estado        String    @default("activo")
  fechaFin      DateTime? @map("fecha_fin") @db.Date
  actualizadoEn DateTime  @updatedAt @map("actualizado_en")

  cliente    Cliente           @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  entrenador PerfilEntrenador? @relation(fields: [entrenadorId], references: [id])

  @@index([tenantId, clienteId, estado])
  @@map("objetivos_socios")
}

model Ejercicio {
  id            Int      @id @default(autoincrement())
  tenantId      Int      @map("tenant_id")
  nombre        String   @db.VarChar(120)
  descripcion   String?  @db.Text
  grupoMuscular String   @map("grupo_muscular") @db.VarChar(60)
  categoria     String?  @db.VarChar(60)
  equipamiento  String?  @db.VarChar(100)
  dificultad    String?  @db.VarChar(40)
  instrucciones String?  @db.Text
  videoUrl      String?  @map("video_url") @db.Text
  imagenUrl     String?  @map("imagen_url") @db.Text
  observaciones String?  @db.Text
  activo        Boolean  @default(true)
  creadoEn      DateTime @default(now()) @map("creado_en")

  tenant   Tenant            @relation(fields: [tenantId], references: [id])
  rutinas  RutinaEjercicio[]
  sesiones EjercicioSesion[]

  @@unique([tenantId, nombre])
  @@index([tenantId, grupoMuscular, activo])
  @@map("ejercicios")
}

model Rutina {
  id              Int      @id @default(autoincrement())
  tenantId        Int      @map("tenant_id")
  nombre          String   @db.VarChar(140)
  descripcion     String?  @db.Text
  objetivo        String?  @db.VarChar(100)
  nivel           String?  @db.VarChar(40)
  duracionMinutos Int?     @map("duracion_minutos")
  diasCantidad    Int?     @map("dias_cantidad")
  entrenadorId    Int?     @map("entrenador_id")
  recomendaciones String?  @db.Text
  estado          String   @default("activo")
  creadoEn        DateTime @default(now()) @map("creado_en")
  actualizadoEn   DateTime @updatedAt @map("actualizado_en")

  tenant       Tenant                    @relation(fields: [tenantId], references: [id])
  entrenador   PerfilEntrenador?         @relation(fields: [entrenadorId], references: [id])
  ejercicios   RutinaEjercicio[]
  fases        FasePlan[]
  asignaciones AsignacionEntrenamiento[]
  sesiones     SesionEntrenamiento[]

  @@index([tenantId, estado, nombre])
  @@map("rutinas")
}

model RutinaEjercicio {
  id               Int      @id @default(autoincrement())
  rutinaId         Int      @map("rutina_id")
  ejercicioId      Int      @map("ejercicio_id")
  dia              Int      @default(1)
  orden            Int
  series           Int?
  repeticiones     String?  @db.VarChar(30)
  pesoSugerido     Decimal? @map("peso_sugerido") @db.Decimal(8, 2)
  descansoSegundos Int?     @map("descanso_segundos")
  tiempoSegundos   Int?     @map("tiempo_segundos")
  observaciones    String?  @db.Text

  rutina    Rutina    @relation(fields: [rutinaId], references: [id], onDelete: Cascade)
  ejercicio Ejercicio @relation(fields: [ejercicioId], references: [id])

  @@unique([rutinaId, dia, orden])
  @@index([ejercicioId])
  @@map("rutina_ejercicios")
}

model PlanEntrenamiento {
  id              Int      @id @default(autoincrement())
  tenantId        Int      @map("tenant_id")
  nombre          String   @db.VarChar(140)
  descripcion     String?  @db.Text
  objetivo        String?  @db.VarChar(100)
  duracionSemanas Int      @map("duracion_semanas")
  estado          String   @default("activo")
  creadoEn        DateTime @default(now()) @map("creado_en")

  tenant       Tenant                    @relation(fields: [tenantId], references: [id])
  fases        FasePlan[]
  asignaciones AsignacionEntrenamiento[]

  @@index([tenantId, estado])
  @@map("planes_entrenamiento")
}

model FasePlan {
  id           Int @id @default(autoincrement())
  planId       Int @map("plan_id")
  rutinaId     Int @map("rutina_id")
  orden        Int
  semanaInicio Int @map("semana_inicio")
  semanaFin    Int @map("semana_fin")

  plan   PlanEntrenamiento @relation(fields: [planId], references: [id], onDelete: Cascade)
  rutina Rutina            @relation(fields: [rutinaId], references: [id])

  @@unique([planId, orden])
  @@map("fases_plan")
}

model AsignacionEntrenamiento {
  id          Int       @id @default(autoincrement())
  tenantId    Int       @map("tenant_id")
  clienteId   Int       @map("cliente_id")
  planId      Int?      @map("plan_id")
  rutinaId    Int?      @map("rutina_id")
  fechaInicio DateTime  @map("fecha_inicio") @db.Date
  fechaFin    DateTime? @map("fecha_fin") @db.Date
  estado      String    @default("activa")
  notas       String?   @db.Text

  tenant   Tenant                @relation(fields: [tenantId], references: [id])
  cliente  Cliente               @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  plan     PlanEntrenamiento?    @relation(fields: [planId], references: [id])
  rutina   Rutina?               @relation(fields: [rutinaId], references: [id])
  sesiones SesionEntrenamiento[]

  @@index([tenantId, clienteId, estado])
  @@map("asignaciones_entrenamiento")
}

model SesionEntrenamiento {
  id              Int       @id @default(autoincrement())
  tenantId        Int       @map("tenant_id")
  clienteId       Int       @map("cliente_id")
  asignacionId    Int?      @map("asignacion_id")
  rutinaId        Int?      @map("rutina_id")
  diaRutina       Int?      @map("dia_rutina")
  iniciadaEn      DateTime  @default(now()) @map("iniciada_en")
  finalizadaEn    DateTime? @map("finalizada_en")
  duracionMinutos Int?      @map("duracion_minutos")
  cumplimiento    Decimal?  @db.Decimal(5, 2)
  comentario      String?   @db.Text
  estado          String    @default("en_curso")

  tenant     Tenant                   @relation(fields: [tenantId], references: [id])
