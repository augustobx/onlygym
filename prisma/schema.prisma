  comentario        String?  @db.VarChar(255)

  ejercicioSesion EjercicioSesion @relation(fields: [ejercicioSesionId], references: [id], onDelete: Cascade)

  @@unique([ejercicioSesionId, numero])
  @@map("series_entrenamiento")
}

