  @@index([tenantId, clienteId])
  @@index([userId])
  @@map("web_push_subscriptions")
}

model RegistroNotificacion {
  id           Int      @id @default(autoincrement())
  tenantId     Int      @map("tenant_id")
  clienteId    Int?     @map("cliente_id")
  canal        String   @db.VarChar(30) // "in_app", "push", "whatsapp", "email"
  tipo         String   @db.VarChar(60)
  destinatario String?  @db.VarChar(150)
  titulo       String   @db.VarChar(200)
  mensaje      String   @db.Text
  estado       String   @default("enviado") // "enviado", "fallido", "leido", "reintentado"
  error        String?  @db.Text
  reintentos   Int      @default(0)
  creadoEn     DateTime @default(now()) @map("creado_en")

